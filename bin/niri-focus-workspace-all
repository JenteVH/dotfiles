#!/usr/bin/env bash
# Switch every connected monitor to a workspace index, then restore monitor focus.
set -euo pipefail

if [[ $# != 1 || ! $1 =~ ^[1-9][0-9]*$ || ${#1} -gt 3 ]] || (( $1 > 255 )); then
    echo "Usage: niri-focus-workspace-all <workspace-number: 1-255>" >&2
    exit 2
fi

# Keep rapid key presses from interleaving monitor switches.
exec 9>"${XDG_RUNTIME_DIR:?}/niri-focus-workspace-all.lock"
flock 9

workspaces=$(niri msg -j workspaces)
original_output=$(jq -r '.[] | select(.is_focused) | .output // empty' <<< "$workspaces")
[[ -n $original_output ]] || exit 0

restore_focus() {
    niri msg action focus-monitor "$original_output" >/dev/null || true
}
trap restore_focus EXIT

# Workspace indices are per monitor. Clamp to the last available workspace
# when the requested index does not exist on a monitor.
targets=$(jq -r --argjson index "$1" --arg original "$original_output" '
    [.[] | select(.output != null)]
    | group_by(.output)
    | map({output: .[0].output, index: ([$index, (map(.idx) | max)] | min)})
    | sort_by(.output == $original)
    | .[] | [.output, .index] | @tsv
' <<< "$workspaces")

while IFS=$'\t' read -r output index; do
    [[ -n $output ]] || continue
    niri msg action focus-monitor "$output"
    niri msg action focus-workspace "$index"
done <<< "$targets"
