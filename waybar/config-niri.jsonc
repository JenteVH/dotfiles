// -*- mode: jsonc -*-
// niri-specific waybar config. Spawned by niri via:
//   spawn-at-startup "waybar" "-c" "/home/jente/.config/waybar/config-niri.jsonc"
// Hyprland still uses ~/.config/waybar/config.jsonc unchanged.
[
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "output": ["DP-3", "HDMI-A-2", "HDMI-A-3", "DP-2"],

    "modules-left": [
        "niri/workspaces",
        "wlr/taskbar",
        "custom/media"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "tray",
        "custom/nixos-update",
        "custom/profile-update",
        "bluetooth",
        "network",
        "pulseaudio",
        "cpu",
        "memory",
        "disk",
        "custom/temps",
        "clock",
        "custom/power"
    ],

    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": false,
        "disable-click": false
    },

    "niri/window": {
        "format": "{title}",
        "separate-outputs": true
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8,
        "show-passive-items": true
    },

    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S}",
        "format-alt": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "cpu": {
        "interval": 2,
        "format": " CPU {usage}%",
        "tooltip": true,
        "on-click": "kitty --class btop btop"
    },

    "memory": {
        "interval": 2,
        "format": " RAM {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB\nSwap: {swapUsed:0.1f}GB / {swapTotal:0.1f}GB",
        "on-click": "kitty --class btop btop"
    },

    "disk": {
        "interval": 30,
        "format": " Disk {percentage_used}%",
        "path": "/",
        "tooltip-format": "Used: {used} / {total}\nFree: {free} ({percentage_free}%)",
        "on-click": "kitty --class baobab baobab"
    },

    "custom/temps": {
        "exec": "~/.config/waybar/scripts/temperatures.sh",
        "return-type": "json",
        "interval": 3,
        "tooltip": true
    },

    "network": {
        "interval": 2,
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰌙 Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}\n {essid} ({signalStrength}%)\nIP: {ipaddr}\nUp: {bandwidthUpBytes} Down: {bandwidthDownBytes}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}\nUp: {bandwidthUpBytes} Down: {bandwidthDownBytes}",
        "on-click": "kitty --class nmtui nmtui"
    },

    "bluetooth": {
        "format": " {status}",
        "format-connected": " {num_connections}",
        "format-disabled": "",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "  {volume}%",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}\nVolume: {volume}%"
    },

    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎵"
        },
        "escape": true,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{markup_escape(title)}}\", \"tooltip\": \"{{playerName}} : {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F 2>/dev/null",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "custom/nixos-update": {
        "format": "󱄅",
        "tooltip": true,
        "tooltip-format": "NixOS system update",
        "on-click": "kitty --hold --class updates sh -c 'sudo nix-env --delete-generations +3 -p /nix/var/nix/profiles/system && sudo nix-collect-garbage && sudo nixos-rebuild switch --flake /etc/nixos#nixos'"
    },

    "custom/profile-update": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Update user profile packages",
        "on-click": "kitty --hold --class updates sh -c 'nix profile upgrade \".*\"'"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "icon-theme": "Papirus-Dark",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [],
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        },
        "rewrite": {
            "Firefox Web Browser": "Firefox",
            "Foot Server": "Terminal"
        }
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    }
}
]
